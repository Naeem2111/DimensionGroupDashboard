# Required: Postgres connection string used by Prisma (Vercel Postgres or Neon).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# Session signing (required in production: min 16 characters).
# DG_SESSION_SECRET=change-me-to-a-long-random-string

# First-run bootstrap admin when the users table is empty (defaults: admin / changeme)
# DG_ADMIN_USERNAME=admin
# DG_ADMIN_PASSWORD=changeme

# Website contact form ingestion (POST /api/public/enquiry)
# Comma-separated origins allowed to submit (defaults include dimensiongroupglobal.com + localhost).
# WEBSITE_INGEST_ORIGINS=https://dimensiongroupglobal.com,https://www.dimensiongroupglobal.com

# Dashboard URL (custom domain on Vercel)
# https://admin.dimensiongroupglobal.com

# Optional: require X-Ingest-Key header on public enquiry API (not recommended in static-site JS).
# WEBSITE_INGEST_KEY=your-secret-key

# Optional: n8n lead outreach (cPanel SMTP in n8n — not Gmail).
# Must match the X-Api-Key / $env.N8N_API_KEY used by the imported workflow.
# N8N_API_KEY=your-secret-key

# Optional: n8n webhook URL for /api/workflow/trigger
# N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/xxxx

# Optional: from address used by n8n emailSend nodes (default connect@…)
# FROM_EMAIL=connect@dimensiongroupglobal.com

# cPanel SMTP is configured inside n8n Credentials UI (not Next.js):
#   Host: mail.dimensiongroupglobal.com
#   Port: 465 (SSL) or 587 (STARTTLS)
#   User: connect@dimensiongroupglobal.com
#   Password: cPanel mailbox password

# Optional: descriptive User-Agent for geocoding (Nominatim usage policy).
# GEOCODER_USER_AGENT=DimensionGroupDashboard (connect@dimensiongroupglobal.com)
