{
  "name": "dimension-group-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Dimension Group marketing lead dashboard — Next.js, Prisma, Postgres",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && node scripts/ensure-db-migrations.mjs && prisma db push && next build",
    "build:full": "prisma generate && next build",
    "start": "next start",
    "scrape": "python scrape_architects.py",
    "scrape:sample": "python scrape_architects.py --limit 30 --max-pages 1 --no-landscape --out data/architects-sample.json",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "db:seed:sample": "node prisma/seed.mjs --sample --replace-architects",
    "geocode:architects": "node scripts/geocode-architects.mjs",
    "geocode:architects:all": "node scripts/apply-geocache-to-db.mjs && node scripts/geocode-architects.mjs --all",
    "geocode:architects:fast": "node scripts/geocode-architects-bulk.mjs",
    "n8n": "npx n8n",
    "n8n:docker": "docker compose -f docker-compose.n8n.yml up -d"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "next": "^14.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "prisma": "^6.8.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0"
  }
}
